---
import Layout from "@/components/Layout.astro";
import Header from "@/components/Header.astro";
import PageContent from "@/components/PageContent.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CopySnippet from "@/components/CopySnippet";
import { SITE_AUTHOR, copyrightText } from "@zrr-website/site-meta";
import { friends } from "@/friends";

const githubEdit =
  "https://github.com/zrr1999/zrr.dev/edit/main/apps/root/src/friends.ts";

const mySite = JSON.stringify(
  {
    name: SITE_AUTHOR,
    url: "https://zrr.dev",
    desc: `${SITE_AUTHOR}的个人主页`,
    avatar:
      "https://raw.githubusercontent.com/zrr1999/hosting/main/images/profile/personal/avatar.png",
  },
  null,
  2,
);

const yourSite = JSON.stringify(
  { name: "你的网站", url: "https://example.com" },
  null,
  2,
);

const steps: {
  title: string;
  detail: string;
  code?: string;
  link?: { href: string; text: string };
}[] = [
  {
    title: "先友后链",
    detail:
      "在你的站点添加本站链接。下面是本站信息，字段可按需取用；提交到本站时只要 name 与 url。",
    code: mySite,
  },
  {
    title: "提交到 GitHub",
    detail:
      "在友链列表里追加你的站点。打开 GitHub 上的编辑页即可，对应文件是 apps/root/src/friends.ts。",
    code: yourSite,
    link: {
      href: githubEdit,
      text: "在 GitHub 上提交站点",
    },
  },
  {
    title: "等待合入",
    detail:
      "PR 合入后会自动部署，首页与本页同时更新。没有 GitHub 账号需要先注册并 fork；若 PR 未合入，可以发邮件到 me@zrr.dev 说明。",
  },
];

const criteria = ["内容以原创为主，转载内容尽可能少", "站点使用 HTTPS"];
---

<Layout
  title={`友链 — ${SITE_AUTHOR}`}
  description="朋友们的站点，以及互换友链的方式与标准。"
  ambient={false}
>
  <Header />

  <PageContent>
    <section class="reveal">
      <h1
        class="display-font text-[clamp(3rem,10vw,7.5rem)] leading-[0.95] font-bold tracking-[-0.03em] text-(--fg) uppercase"
      >
        友链<span class="text-(--accent)"> / Friends</span>
      </h1>
      <p
        class="mt-8 max-w-2xl text-base leading-relaxed text-(--muted) md:text-lg"
      >
        朋友们的站点。想出现在名单里，先在你那边放上本站，再通过 GitHub 提交。
      </p>
      <a
        href="#exchange"
        class="mt-5 inline-block text-[15px] font-medium text-(--fg) underline decoration-(--subtle) underline-offset-4 transition-colors hover:text-(--accent)"
      >
        互换方式 →
      </a>
    </section>

    <section class="reveal reveal-2 mt-20 md:mt-24">
      <SectionHeading>朋友们 / Friends</SectionHeading>

      <div class="mt-4">
        {
          friends.map(friend => (
            <a
              href={friend.url}
              class="link-row group grid grid-cols-[1fr_auto] items-baseline gap-6 border-t border-(--card-border) py-4 last:border-b"
            >
              <span class="flex items-baseline gap-6">
                <span class="text-[15px] font-medium text-(--fg) transition-colors duration-150 group-hover:text-(--accent)">
                  {friend.name}
                </span>
                <span class="mono text-xs text-(--subtle)">
                  {new URL(friend.url).host}
                </span>
              </span>
              <span
                class="text-sm text-(--subtle) transition-colors duration-150 group-hover:text-(--accent)"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section
      id="exchange"
      class="reveal reveal-3 mt-20 scroll-mt-24 md:mt-24"
    >
      <SectionHeading>互换 / Exchange</SectionHeading>

      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-(--muted)">
        先友后链：你的站点放上本站之后，再把你的站点提交过来。
      </p>

      <ul
        class="mt-4 max-w-2xl list-disc space-y-1 pl-5 text-sm leading-relaxed text-(--muted)"
      >
        {criteria.map(item => <li>{item}</li>)}
      </ul>

      <div class="mt-4">
        {
          steps.map(step => (
            <div class="border-t border-(--card-border) py-6 last:border-b">
              <h3 class="text-[15px] font-medium text-(--fg)">{step.title}</h3>
              <p class="mt-1 max-w-2xl text-sm leading-relaxed text-(--muted)">
                {step.detail}
              </p>
              {step.code && (
                <div class="relative mt-3 max-w-2xl border border-(--card-border)">
                  <div class="absolute top-2.5 right-3">
                    <CopySnippet client:load text={step.code} />
                  </div>
                  <pre class="mono px-4 py-3 pr-14 text-xs whitespace-pre-wrap break-all text-(--muted)">
{step.code}</pre>
                </div>
              )}
              {step.link && (
                <a
                  href={step.link.href}
                  class="mt-3 inline-block text-[15px] font-medium text-(--fg) underline decoration-(--subtle) underline-offset-4 transition-colors hover:text-(--accent)"
                >
                  {step.link.text} ↗
                </a>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <footer
      class="mono mt-24 flex flex-wrap items-baseline justify-between gap-3 border-t border-(--card-border) pt-6 text-xs text-(--subtle)"
    >
      <span>{copyrightText()}</span>
      <span>
        <a href="/" class="transition-colors hover:text-(--fg)">首页</a>
        <span class="mx-2">·</span>
        <a
          href="https://github.com/zrr1999"
          class="transition-colors hover:text-(--fg)">GitHub</a
        >
      </span>
    </footer>
  </PageContent>
</Layout>
